#! /bin/bash 


# check systems-level tools, install any that is missing 
#create an associative to use  to map 
declare -A pkg_map=(
		[python3]="python3"
		[pip3]="python3-pip"
		[ffmpeg]="ffmpeg"
		[yt-dlp]="yt-dlp"
) 
check_tools-deps() {
missing=()
for cmd in python3 pip3 ffmpeg yt-dlp; do 
	echo -n "$cmd: "
if 
	command -v  $cmd  &>/dev/null; then
 $cmd --version 2>&1 | head -1 
else 
	echo  "NOT INSTALLED !!!"
	missing+=("$cmd")
fi 
done
}
# installing  the  dependancies 
install_tools() {
# check that the array is not empty 
if [ ${#missing[@]} -gt 0 ];  then 
	echo "Installing: ${missing[*]}"
	for cmd in  "${missing[@]}"; do 
		sudo apt install -y "${pkg_map[$cmd]}"
 echo "The following dependancies are being installed ${missing[*]}"
		done 
fi 
}
#check for js runtime 
check_js_runtime() {
	if command -v deno &>/dev/null ;then 
	echo "deno: $(deno --version | head -1 )"
	return 
fi 
	echo "deno: NOT INSTALLED (optional, but required for reliable Youtube extraction)"
	read -rp "Install deno now? [y/N] " reply 
	if [[ "$reply" =~ ^[Yy]$  ]]; then 
    	 curl -fsSL https://deno.land/install.sh | sh 
	echo "Add deno to Your PATH (see installer output above) before running yt-dlp again"
	fi 
}
check_tools-deps
install_tools
check_js_runtime

